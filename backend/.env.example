# Django — generate a unique secret; never commit real values
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local defaults — change for shared/prod environments)
POSTGRES_DB=disease_prediction_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: used only by ml_models/seed_demo_data.py
# DEMO_PATIENT_PASSWORD=
# DEMO_PROVIDER_PASSWORD=
# DEMO_PATIENT_USERNAME=demo_patient
# DEMO_PROVIDER_USERNAME=demo_provider

# CORS and CSRF (comma-separated origins; required for SPA session auth)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
